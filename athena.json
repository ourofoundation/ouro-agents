{
  "env_file": ".env.athena",
  "security": {
    "controllers": [
      "mmoderwell"
    ],
    "trusted": [
      "hermes",
      "apollo"
    ],
    "run_secret": null
  },
  "agent": {
    "name": "athena",
    "workspace": "./agents/athena",
    "org_id": "00000000-0000-0000-0000-000000000000"
  },
  "models": {
    "strong": {
      "id": "qwen/qwen3.7-plus",
      "reasoning": {
        "effort": "medium"
      }
    },
    "light": {
      "id": "xiaomi/mimo-v2-flash",
      "reasoning": {
        "effort": "none"
      }
    }
  },
  "subagents": {
    "preflight": {
      "max_steps": 4
    },
    "research": {
      "max_steps": 10
    },
    "executor": {
      "max_steps": 24
    }
  },
  "modes": {
    "planning": {
      "enabled": true,
      "max_steps": 20,
      "cadence": "4h",
      "min_heartbeats": 4,
      "review_window": "1h",
      "auto_approve": true
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "max_steps": 20,
      "active_hours": {
        "start": "09:00",
        "end": "22:00",
        "timezone": "America/Chicago"
      },
      "proactive": {
        "enabled": true,
        "servers": [
          "ouro",
          "search"
        ]
      }
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/athena/memory",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "dream_enabled": true,
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8015,
    "webhook_path": "/athena/events"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  }
}
