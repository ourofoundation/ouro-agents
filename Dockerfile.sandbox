# Docker build command:
#   make base
#   docker build -f Dockerfile.sandbox -t ouro-agents-sandbox:latest .


FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --no-install-recommends --yes git gh \
    && git config --system --add safe.directory "*" \
    && rm -rf /var/lib/apt/lists/*

# Heavy / rarely-changing deps first so ouro-py bumps don't invalidate this layer.
# Pin pymatgen-core to a release with manylinux wheels; newer sdist-only
# versions need a C compiler that slim does not include.
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        httpx \
        ase \
        numpy \
        pandas \
        "pymatgen-core==2026.5.18" \
        pymatgen \
        scipy \
        spglib \
        requests \
        modal \
        exa_py

# Thin layer: bump OURO_PY_VERSION without rebuilding the stack above.
# ARG must sit immediately above this RUN — a file-level ARG would bust pymatgen.
ARG OURO_PY_VERSION=0.11.17
RUN python -m pip install --no-cache-dir "ouro-py==${OURO_PY_VERSION}"

WORKDIR /workspace
