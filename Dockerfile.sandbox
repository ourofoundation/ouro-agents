FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        ouro-py==0.10.0 \
        httpx \
        ase \
        numpy \
        pandas \
        pymatgen \
        scipy \
        spglib \
        requests \
        modal

WORKDIR /workspace
