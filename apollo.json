{
  "env_file": ".env.apollo",
  "controller": {
    "username": "mmoderwell"
  },
  "agent": {
    "name": "apollo",
    "model": "deepseek/deepseek-v4-pro",
    "reasoning": {
      "effort": "high"
    },
    "workspace": "./agents/apollo",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "python_packages": [
      "numpy.*",
      "scipy.*",
      "ase.*",
      "pymatgen.*",
      "spglib.*"
    ]
  },
  "openrouter_provider": {
    "ignore": [
      "Parasail"
    ],
    "allow_fallbacks": true
  },
  "subagents": {
    "preflight": {
      "model": "deepseek/deepseek-v4-pro",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 4
    },
    "research": {
      "model": "deepseek/deepseek-v4-pro",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 10
    },
    "writer": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "executor": {
      "max_steps": 24
    }
  },
  "modes": {
    "planning": {
      "enabled": true,
      "model": "deepseek/deepseek-v4-pro",
      "max_steps": 20,
      "cadence": "8h",
      "min_heartbeats": 4,
      "review_window": "1h",
      "auto_approve": false
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "model": "deepseek/deepseek-v4-pro",
      "max_steps": 20,
      "active_hours": {
        "start": "08:30",
        "end": "21:30",
        "timezone": "America/Chicago"
      },
      "proactive": {
        "enabled": true,
        "servers": [
          "ouro",
          "search"
        ]
      }
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/apollo/memory",
    "extraction_model": "deepseek/deepseek-v4-pro",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "retrieval_queries": 3,
    "max_retrieval_tokens": 1500,
    "consolidation_enabled": true,
    "memory_md_max_tokens": 1500,
    "mid_session_reflection_interval": 5,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "event_pooling": {
    "enabled": true,
    "events": {
      "new-message": {
        "enabled": true,
        "settle_seconds": 2,
        "jitter_seconds": 3,
        "max_wait_seconds": 8
      },
      "comment": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      },
      "mention": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      }
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8020,
    "webhook_path": "/apollo/events"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  }
}