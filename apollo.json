{
  "env_file": ".env.apollo",
  "security": {
    "controllers": [
      "mmoderwell",
      "hermes"
    ],
    "trusted": [
      "hermes",
      "athena",
      "will"
    ],
    "run_secret": null
  },
  "agent": {
    "name": "apollo",
    "workspace": "./agents/apollo",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "sandbox": {
      "mode": "docker",
      "enable_shell": true,
      "python_packages": [
        "numpy.*",
        "scipy.*",
        "ase.*",
        "pymatgen.*",
        "spglib.*",
        "modal.*"
      ],
      "image": "ouro-agents-sandbox-apollo:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "4g",
      "cpus": 2.0,
      "pids_limit": 512,
      "timeout_seconds": 600,
      "max_output_chars": 50000,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL",
        "MODAL_TOKEN_ID",
        "MODAL_TOKEN_SECRET"
      ]
    }
  },
  "models": {
    "strong": {
      "id": "z-ai/glm-5.2",
      "reasoning": {
        "effort": "high"
      }
    },
    "mid": {
      "id": "z-ai/glm-5.2",
      "reasoning": {
        "effort": "high"
      }
    },
    "light": {
      "id": "xiaomi/mimo-v2.5",
      "reasoning": {
        "effort": "none"
      }
    }
  },
  "openrouter_provider": {
    "ignore": [
      "Parasail"
    ],
    "allow_fallbacks": true
  },
  "subagents": {
    "search": {
      "max_steps": 4
    },
    "research": {
      "max_steps": 8
    },
    "reflector": {
      "max_steps": 5
    },
    "executor": {
      "max_steps": 10
    }
  },
  "modes": {
    "autonomous": {
      "max_steps": 40
    },
    "planning": {
      "enabled": false,
      "max_steps": 20,
      "cadence": "8h",
      "min_heartbeats": 4,
      "review_window": "1h",
      "auto_approve": false
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "max_steps": 40,
      "active_hours": {
        "start": "08:00",
        "end": "21:00",
        "timezone": "America/Chicago"
      },
      "servers": [
        "ouro"
      ]
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/apollo/protected/memory",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "dream_enabled": true,
    "rhythm": "weekly",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "event_pooling": {
    "enabled": true,
    "events": {
      "new-message": {
        "enabled": false
      },
      "comment": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      },
      "mention": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      }
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    {
      "name": "resend",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp"
      ],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "${RESEND_SENDER}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8020,
    "webhook_path": "/apollo/events",
    "public_base_url": "https://agents.ouro.foundation/apollo"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  },
  "agent_routes": {
    "enabled": true,
    "path_prefix": "/routes"
  }
}