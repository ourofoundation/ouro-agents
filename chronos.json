{
  "env_file": ".env.chronos",
  "security": {
    "controllers": [
      "mmoderwell"
    ],
    "trusted": [
      "hermes",
      "apollo",
      "magnes",
      "athena"
    ],
    "run_secret": null
  },
  "agent": {
    "name": "chronos",
    "workspace": "./agents/chronos",
    "org_id": "0193d805-52f4-786a-8144-95f892915302",
    "sandbox": {
      "mode": "docker",
      "enable_shell": true,
      "python_packages": [
        "numpy.*",
        "pandas.*",
        "scipy.*",
        "statistics",
        "math",
        "datetime"
      ],
      "image": "ouro-agents-sandbox:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "2g",
      "cpus": 2.0,
      "pids_limit": 512,
      "timeout_seconds": 300,
      "max_output_chars": 50000,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL"
      ]
    }
  },
  "models": {
    "strong": {
      "id": "openai/gpt-5.6-sol",
      "reasoning": {
        "effort": "medium"
      }
    },
    "mid": {
      "id": "z-ai/glm-5.3-flash",
      "reasoning": {
        "effort": "high"
      }
    },
    "light": {
      "id": "z-ai/glm-5.3-flash",
      "reasoning": {
        "effort": "high"
      }
    }
  },
  "openrouter_provider": {
    "allow_fallbacks": true
  },
  "subagents": {
    "search": {
      "max_steps": 4
    },
    "research": {
      "max_steps": 8
    },
    "reflector": {
      "max_steps": 5
    },
    "executor": {
      "max_steps": 16
    },
    "developer": {
      "max_steps": 20
    }
  },
  "modes": {
    "autonomous": {
      "max_steps": 40
    },
    "chat": {
      "max_steps": 30
    },
    "planning": {
      "enabled": true,
      "max_steps": 20,
      "cadence": "24h",
      "min_heartbeats": 4,
      "review_window": "2h",
      "auto_approve": true,
      "max_plans_per_day": 1,
      "backlog_limit": 6
    },
    "heartbeat": {
      "enabled": true,
      "every": "2h",
      "max_steps": 50,
      "active_hours": {
        "start": "07:00",
        "end": "21:00",
        "timezone": "America/Chicago"
      },
      "servers": [
        "ouro"
      ],
      "curiosity": {
        "enabled": true,
        "last_beats": 2
      }
    }
  },
  "dream": {
    "enabled": true,
    "every": "1d",
    "at": "03:00",
    "timezone": "America/Chicago",
    "min_new_runs": 3,
    "max_steps": 40,
    "max_changes": 4,
    "journal_lookback": 3,
    "servers": [
      "ouro"
    ],
    "dry_run": true
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/chronos/protected/memory",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "rhythm": "weekly",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 60,
    "graph": {
      "enabled": false
    }
  },
  "event_pooling": {
    "enabled": true,
    "events": {
      "comment": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      },
      "mention": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      }
    }
  },
  "event_delivery": {
    "events": {
      "comment": "heartbeat",
      "mention": "heartbeat"
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8035,
    "webhook_path": "/chronos/events",
    "public_base_url": "https://agents.ouro.foundation/chronos"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  },
  "agent_routes": {
    "enabled": true,
    "path_prefix": "/routes"
  }
}