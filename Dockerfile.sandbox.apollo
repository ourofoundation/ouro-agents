# Apollo's sandbox: the shared base plus service-building tools
# (git for cloning model repos, modal for deploys, spglib for symmetry work).
# Build the base first: docker build -f Dockerfile.sandbox -t ouro-agents-sandbox:latest .
FROM ouro-agents-sandbox:latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
        modal \
        spglib
