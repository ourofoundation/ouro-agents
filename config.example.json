{
  "agent": {
    "name": "hermes",
    "model": "xiaomi/mimo-v2-flash",
    "reasoning": {
      "effort": "medium"
    },
    "workspace": "./workspace",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "sandbox": {
      "mode": "local",
      "python_packages": [],
      "image": "ouro-agents-sandbox:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "1g",
      "cpus": 1.0,
      "pids_limit": 256,
      "timeout_seconds": 30,
      "max_output_chars": 50000,
      "enable_shell": false,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL"
      ]
    }
  },
  "security": {
    "controllers": [
      "your-handle"
    ],
    "trusted": [],
    "run_secret": null
  },
  "subagents": {
    "preflight": {
      "model": "xiaomi/mimo-v2-flash",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 4
    },
    "research": {
      "model": "xiaomi/mimo-v2-flash",
      "reasoning": {
        "effort": "low"
      },
      "max_steps": 10
    },
    "writer": {
      "model": "xiaomi/mimo-v2-flash"
    },
    "executor": {
      "max_steps": 24
    }
  },
  "modes": {
    "chat": {
      "max_steps": 40
    },
    "run": {
      "max_steps": 60
    },
    "planning": {
      "enabled": true,
      "model": "anthropic/claude-4.6-sonnet",
      "cadence": "4h",
      "min_heartbeats": 4,
      "review_window": "1h",
      "auto_approve": true,
      "max_steps": 6
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "model": "xiaomi/mimo-v2-flash",
      "active_hours": {
        "start": "09:00",
        "end": "17:00",
        "timezone": "America/Chicago"
      },
      "proactive": {
        "enabled": true,
        "servers": [
          "ouro",
          "search"
        ]
      },
      "max_steps": 20
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./workspace/memory",
    "extraction_model": "xiaomi/mimo-v2-flash",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "rhythm": "daily",
    "dream_enabled": true,
    "dream_time": "03:00",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/Users/mmoderwell/.pyenv/versions/ouro/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  },
  "display": {
    "usage_table": {
      "show_reasoning": false
    },
    "serve_progress": {
      "enabled": true,
      "style": "timeline",
      "show_spinner": true,
      "show_prefetch": true,
      "show_token_updates": true,
      "show_subagents": true
    }
  },
  "run_log": {
    "enabled": true,
    "capture_steps": true,
    "capture_reasoning": true,
    "capture_observations": true,
    "max_observation_chars": 0,
    "capture_subagent_runs": true,
    "expose_to_agent": true,
    "agent_default_scope": "team",
    "agent_max_results": 10,
    "agent_max_detail_chars": 6000
  }
}