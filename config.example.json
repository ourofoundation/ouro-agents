{
  "agent": {
    "name": "hermes",
    "workspace": "./workspace",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "sandbox": {
      "mode": "local",
      "python_packages": [],
      "image": "ouro-agents-sandbox:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "1g",
      "cpus": 1.0,
      "pids_limit": 256,
      "timeout_seconds": 300,
      "max_output_chars": 50000,
      "enable_shell": false,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL"
      ]
    }
  },
  "models": {
    "strong": {
      "id": "anthropic/claude-4.6-sonnet",
      "reasoning": {
        "effort": "medium"
      },
      "max_completion_tokens": 16384
    },
    "mid": {
      "id": "xiaomi/mimo-v2-flash",
      "reasoning": {
        "effort": "none"
      },
      "max_completion_tokens": 8192
    },
    "light": {
      "id": "xiaomi/mimo-v2-flash",
      "reasoning": {
        "effort": "none"
      },
      "max_completion_tokens": 4096
    }
  },
  "security": {
    "controllers": [
      "your-handle"
    ],
    "trusted": [],
    "run_secret": null
  },
  "subagents": {
    "strategist": {
      "max_steps": 5
    },
    "research": {
      "max_steps": 10
    },
    "executor": {
      "max_steps": 24
    }
  },
  "modes": {
    "chat": {
      "max_steps": 40
    },
    "run": {
      "max_steps": 60
    },
    "planning": {
      "enabled": true,
      "cadence": "4h",
      "min_heartbeats": 4,
      "review_window": "1h",
      "auto_approve": true,
      "max_steps": 6
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "active_hours": {
        "start": "09:00",
        "end": "17:00",
        "timezone": "America/Chicago"
      },
      "servers": [
        "ouro"
      ],
      "max_steps": 12
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./workspace/memory",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "rhythm": "daily",
    "dream_enabled": true,
    "dream_time": "03:00",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/Users/mmoderwell/.pyenv/versions/ouro/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "webhook_path": "/ouro-agents/events"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  },
  "env_file": ".env"
}
