{
  "env_file": ".env.hermes",
  "security": {
    "controllers": [
      "mmoderwell"
    ],
    "trusted": [
      "athena",
      "apollo"
    ],
    "run_secret": null
  },
  "agent": {
    "name": "hermes",
    "model": "z-ai/glm-5.2",
    "reasoning": {
      "effort": "medium"
    },
    "workspace": "./agents/hermes",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "sandbox": {
      "mode": "docker",
      "enable_shell": true,
      "python_packages": [
        "numpy.*",
        "scipy.*",
        "ase.*",
        "pymatgen.*",
        "modal.*"
      ],
      "image": "ouro-agents-sandbox:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "4g",
      "cpus": 2.0,
      "pids_limit": 512,
      "timeout_seconds": 60,
      "max_output_chars": 50000,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL",
        "MODAL_TOKEN_ID",
        "MODAL_TOKEN_SECRET"
      ]
    }
  },
  "openrouter_provider": {
    "allow_fallbacks": true
  },
  "subagents": {
    "preflight": {
      "model": "xiaomi/mimo-v2.5",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 4
    },
    "research": {
      "model": "xiaomi/mimo-v2.5",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 10
    },
    "reflector": {
      "model": "xiaomi/mimo-v2.5",
      "reasoning": {
        "effort": "none"
      },
      "max_steps": 10
    },
    "writer": {
      "model": "z-ai/glm-5.2"
    },
    "executor": {
      "max_steps": 24
    }
  },
  "modes": {
    "planning": {
      "enabled": true,
      "model": "z-ai/glm-5.2",
      "max_steps": 20,
      "cadence": "6h",
      "min_heartbeats": 4,
      "review_window": "2h",
      "auto_approve": true,
      "max_plans_per_day": 2,
      "backlog_limit": 8
    },
    "heartbeat": {
      "enabled": true,
      "every": "1h",
      "model": "z-ai/glm-5.2",
      "reasoning": {
        "effort": "medium"
      },
      "max_steps": 40,
      "active_hours": {
        "start": "09:00",
        "end": "22:00",
        "timezone": "America/Chicago"
      },
      "proactive": {
        "enabled": true,
        "servers": [
          "ouro",
          "search"
        ]
      }
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/hermes/memory",
    "extraction_model": "xiaomi/mimo-v2.5",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "dream_enabled": true,
    "rhythm": "weekly",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "event_pooling": {
    "enabled": true,
    "events": {
      "new-message": {
        "enabled": true,
        "settle_seconds": 2,
        "jitter_seconds": 3,
        "max_wait_seconds": 8
      },
      "comment": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      },
      "mention": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      }
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    {
      "name": "resend",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp"
      ],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "${RESEND_SENDER}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8010,
    "webhook_path": "/ouro-agents/events"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  }
}