{
  "env_file": ".env.hermes",
  "security": {
    "controllers": [
      "mmoderwell",
      "will"
    ],
    "trusted": [
      "athena",
      "apollo"
    ],
    "run_secret": null
  },
  "agent": {
    "name": "hermes",
    "workspace": "./agents/hermes",
    "org_id": "00000000-0000-0000-0000-000000000000",
    "sandbox": {
      "mode": "docker",
      "enable_shell": true,
      "python_packages": [
        "numpy.*",
        "scipy.*",
        "ase.*",
        "pymatgen.*",
        "modal.*",
        "resend.*",
        "exa_py.*"
      ],
      "image": "ouro-agents-sandbox-hermes:latest",
      "workspace_mount": "/workspace",
      "network": "bridge",
      "memory": "4g",
      "cpus": 2.0,
      "pids_limit": 512,
      "timeout_seconds": 300,
      "max_output_chars": 50000,
      "env_allowlist": [
        "OURO_API_KEY",
        "OURO_BASE_URL",
        "MODAL_TOKEN_ID",
        "MODAL_TOKEN_SECRET",
        "RESEND_API_KEY",
        "RESEND_SENDER",
        "EXA_API_KEY"
      ]
    }
  },
  "models": {
    "strong": {
      "id": "moonshotai/kimi-k3",
      "reasoning": {
        "effort": "high"
      }
    },
    "mid": {
      "id": "z-ai/glm-5.2",
      "reasoning": {
        "effort": "high"
      }
    },
    "light": {
      "id": "openai/gpt-5.6-luna",
      "reasoning": {
        "effort": "none"
      }
    }
  },
  "openrouter_provider": {
    "allow_fallbacks": true
  },
  "subagents": {
    "search": {
      "max_steps": 4
    },
    "research": {
      "max_steps": 8
    },
    "reflector": {
      "max_steps": 5
    },
    "executor": {
      "max_steps": 16
    },
    "developer": {
      "max_steps": 20
    }
  },
  "modes": {
    "planning": {
      "enabled": false,
      "max_steps": 20,
      "cadence": "6h",
      "min_heartbeats": 4,
      "review_window": "2h",
      "auto_approve": true,
      "max_plans_per_day": 2,
      "backlog_limit": 8
    },
    "heartbeat": {
      "enabled": false,
      "every": "1h",
      "max_steps": 40,
      "active_hours": {
        "start": "09:00",
        "end": "22:00",
        "timezone": "America/Chicago"
      },
      "servers": [
        "ouro",
        "resend"
      ],
      "curiosity": {
        "enabled": true,
        "last_beats": 3
      }
    }
  },
  "memory": {
    "provider": "mem0",
    "path": "./agents/hermes/protected/memory",
    "embedder": "openai/text-embedding-3-small",
    "search_limit": 10,
    "max_retrieval_tokens": 1500,
    "dream_enabled": true,
    "rhythm": "weekly",
    "memory_md_max_tokens": 1500,
    "decay_after_days": 30,
    "graph": {
      "enabled": false
    }
  },
  "event_pooling": {
    "enabled": true,
    "events": {
      "new-message": {
        "enabled": false
      },
      "comment": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      },
      "mention": {
        "enabled": true,
        "settle_seconds": 20,
        "jitter_seconds": 60,
        "max_wait_seconds": 180
      }
    }
  },
  "event_delivery": {
    "events": {
      "comment": "heartbeat",
      "mention": "heartbeat"
    }
  },
  "mcp_servers": [
    {
      "name": "ouro",
      "transport": "stdio",
      "command": "/home/matt/.pyenv/versions/agents/bin/python",
      "args": [
        "-m",
        "ouro_mcp.server"
      ],
      "env": {
        "OURO_API_KEY": "${OURO_API_KEY}",
        "OURO_BASE_URL": "${OURO_BASE_URL}"
      }
    },
    {
      "name": "search",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    {
      "name": "resend",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp"
      ],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "${RESEND_SENDER}"
      }
    }
  ],
  "server": {
    "host": "0.0.0.0",
    "port": 8010,
    "webhook_path": "/ouro-agents/events",
    "public_base_url": "https://hermes.ouro.foundation/ouro-agents"
  },
  "prompt_caching": {
    "enabled": true,
    "ttl": "5m"
  },
  "agent_routes": {
    "enabled": true,
    "path_prefix": "/routes"
  }
}